    "    {\"id\": 106, \"driver\": \"Iryna\", \"hour\": 18, \"distance\": 2.4, \"duration\": 9, \"rating\": 3, \"payment\": \"card\", \"status\": \"completed\"},\n",
    "    {\"id\": 107, \"driver\": \"Maksym\", \"hour\": 2, \"distance\": 18.0, \"duration\": 35, \"rating\": 5, \"payment\": \"cash\", \"status\": \"completed\"},\n",
    "    {\"id\": 108, \"driver\": \"Sofia\", \"hour\": 18, \"distance\": 9.6, \"duration\": 33, \"rating\": 4, \"payment\": \"card\", \"status\": \"completed\"},\n",
    "    {\"id\": 109, \"driver\": \"Oleh\", \"hour\": 19, \"distance\": 4.4, \"duration\": 16, \"rating\": 5, \"payment\": \"card\", \"status\": \"completed\"},\n",
